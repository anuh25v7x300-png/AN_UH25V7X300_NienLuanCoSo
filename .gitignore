# Track only application source, runtime assets and launch configuration.
/*
!/.gitignore
!/.gitattributes
!/.bun-version
!/package.json
!/README.md
!/setup.cmd
!/setup.sh
!/start.cmd
!/start.sh
!/scripts/
/scripts/*
!/scripts/setup.js
!/scripts/dev.js
!/scripts/build.js
!/scripts/bootstrap.sh
!/scripts/bootstrap.ps1
!/scripts/bun-checksums.txt
!/backend/
/backend/*
!/backend/.env
!/backend/.env.example
!/backend/package.json
!/backend/bun.lock
!/backend/schema.sql
!/backend/src/
/backend/src/*
!/backend/src/db.js
!/backend/src/index.js
!/backend/src/features.js
!/backend/src/seed.js
!/frontend/
/frontend/*
!/frontend/package.json
!/frontend/bun.lock
!/frontend/index.html
!/frontend/vite.config.js
!/frontend/src/
!/frontend/src/**
!/frontend/public/
/frontend/public/*
!/frontend/public/images/
!/frontend/public/images/**

# Keep generated files, tests and editor configuration out of every subtree.
**/node_modules/
**/dist/
**/build/
**/.runtime/
**/.vscode/
**/.idea/
**/.codex/
**/docs/
**/test/
**/tests/
**/__tests__/
**/coverage/
**/*.test.*
**/*.spec.*
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.log
**/__pycache__/
**/.DS_Store
**/Thumbs.db
